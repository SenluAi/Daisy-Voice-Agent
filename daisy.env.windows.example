# ============================================================================
# Daisy Windows 配置模板
# 复制本文件为 daisy.env 后填入真实值。daisy.env 已在 .gitignore 中，
# 不会被提交。请勿把密钥写入任何其它文件。
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 火山引擎语音识别（豆包 Seed ASR）
#    申请：https://console.volcengine.com/speech/app
#    新版控制台可填 VOLCENGINE_API_KEY；旧版控制台填 App ID + Access Token。
# ----------------------------------------------------------------------------
VOLCENGINE_API_KEY=your_api_key
VOLCENGINE_APP_ID=your_app_id
VOLCENGINE_ACCESS_TOKEN=your_access_token
VOLCENGINE_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# 开启后使用语音唤醒页选择的本地依赖模型；关闭后使用火山 ASR
ASR_LOCAL_SHERPA_FIRST=true
# 本地流式识别开启时使用的依赖模型：wechat / sherpa
ASR_PRIMARY_PROVIDER=wechat

# ----------------------------------------------------------------------------
# 2. DeepSeek LLM
#    申请：https://platform.deepseek.com/api_keys
#    截屏/看图功能复用这里的大模型配置；请填写支持 image_url 图片输入的模型。
# ----------------------------------------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ----------------------------------------------------------------------------
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# 4. Edge TTS 语音（可选，默认 zh-CN-XiaoxiaoNeural）
# ----------------------------------------------------------------------------
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# EDGE_TTS_RATE=+20%
# EDGE_TTS_PITCH=+0Hz
# EDGE_TTS_STYLE=general

# ----------------------------------------------------------------------------
# 5. 全局快捷键（可选）
#    Windows 默认 Space（需按住约 300 毫秒，松开后发送）
#    组合键用 + 连接，如 LeftControl+Space
# ----------------------------------------------------------------------------
# GLOBAL_SHORTCUT=Space
# CONTINUOUS_SHORTCUT=LeftControl+Space

# ----------------------------------------------------------------------------
# 6. 语音唤醒（可选，默认开启）
#    使用本地 Sherpa-ONNX streaming Paraformer bilingual zh-en INT8 模型
#    NUM_THREADS 与 blocksize 可在语音唤醒页自定义；线程范围 1-32，默认 4；blocksize 默认 160 sample / 10ms
# ----------------------------------------------------------------------------
# WAKE_WORD_ENABLED=true
# WAKE_WORD=嘿 Daisy,你好 Daisy
# WAKE_START_LISTENING_TIMEOUT_MS=90000
# WECHAT_SPEECH_RMS_THRESHOLD=260
# MICROPHONE_SENSITIVITY=35
# SHERPA_ONNX_MODEL=sherpa-onnx-streaming-paraformer-bilingual-zh-en
# SHERPA_ONNX_NUM_THREADS=4
# SHERPA_ONNX_BLOCK_SIZE=160

# ----------------------------------------------------------------------------
# 7. 连续对话（可选，默认开启）
#    一轮回答结束后，在指定时间内检测到你继续说话，会自动进入下一轮监听
# ----------------------------------------------------------------------------
# CONTINUOUS_CONVERSATION_ENABLED=true
# CONTINUOUS_CONVERSATION_WINDOW_MS=90000

# ----------------------------------------------------------------------------
# 8. 启动选项（可选）
# ----------------------------------------------------------------------------
# AUTO_LAUNCH=true
# SHOW_DOCK_ICON=true     (Windows: 无 Dock 概念，仅影响托盘图标)
